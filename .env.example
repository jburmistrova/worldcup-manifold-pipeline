# No API credentials needed here. Manifold's public endpoints require no
# auth (see ADR-0001). This project doesn't use Kalshi, which is why there's
# no Kalshi key/secret in this file.

# Unused by the venv/system Java lookup by default. This project's Java (for
# Spark) is installed via Homebrew as keg-only, not symlinked system-wide.
# See requirements.md for why.
JAVA_HOME=/usr/local/opt/openjdk@25

# Only needed when running `dbt build --target postgres` (see ADR-0004).
# The default target (DuckDB) needs none of this. No default for the
# password, on purpose: it's a real credential, never hardcoded or
# committed, unlike the other values here. See requirements.md for how to
# create the Kubernetes Secret this maps to, or CI's postgres service
# container for how it's set there instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=worldcup
POSTGRES_PASSWORD=
POSTGRES_DB=worldcup
